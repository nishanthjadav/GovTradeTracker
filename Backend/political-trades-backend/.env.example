# Database (Supabase — use the transaction pooler host, port 6543)
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

# App secret (used for session/encryption) — generate with: openssl rand -base64 48
APP_SECRET_KEY=

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alpaca trading API (optional global fallback; per-user keys are preferred)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Capitol Trades Cloudflare bypass cookie (refresh this periodically from your browser)
CAPITOLTRADES_VCRCS_COOKIE=

# Frontend URL for CORS (set to your deployed frontend domain)
FRONTEND_URL=https://your-app.vercel.app
